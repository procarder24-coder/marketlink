# Browser-safe Supabase project settings. These are not service-role secrets.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only credentials. Never prefix these with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
RATE_LIMIT_HASH_SECRET=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# MTN MoMo sandbox credentials. Obtain and rotate these in the MTN MoMo Developer Portal.
# Never put these values in a NEXT_PUBLIC_ variable or send them in chat.
MTN_MOMO_API_USER=
MTN_MOMO_API_KEY=
MTN_MOMO_COLLECTION_SUBSCRIPTION_KEY=

# Identity verification is intentionally disabled until a supported provider adapter,
# contract, credentials, and compliance review are in place.
KYC_PROVIDER_NAME=
